PORT=8000

# 飞书开放平台配置
# 1. 登录飞书开放平台: https://open.feishu.cn/
# 2. 创建企业自建应用，获取 App ID 和 App Secret
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# 飞书多维表配置 - 库存管理表
FEISHU_INVENTORY_BASE_TOKEN=your_inventory_base_token
FEISHU_INVENTORY_TABLE_ID=your_inventory_table_id

# 飞书多维表配置 - 差评管理表
FEISHU_REVIEW_BASE_TOKEN=your_review_base_token
FEISHU_REVIEW_TABLE_ID=your_review_table_id

# OpenAI API Key (用于AI分析)
OPENAI_API_KEY=your_openai_api_key

# ============ 火山引擎 TOS 对象存储配置 ============
# 获取步骤：
# 1. 登录火山引擎控制台 https://console.volcengine.com
# 2. 访问「访问密钥」页面创建 AK/SK：https://console.volcengine.com/iam/keymanage/
# 3. 开通 TOS 服务并创建桶：https://console.volcengine.com/tos
# 4. 在桶概览页获取 Endpoint、Region、Bucket 名称
# 5. 桶权限建议设为「公共读」（用于图片/视频直接访问）
#    或使用自定义域名（CDN）通过 TOS_CUSTOM_DOMAIN 配置
#
# AK (Access Key ID)
TOS_ACCESS_KEY=your_tos_access_key
# SK (Secret Access Key)
TOS_SECRET_KEY=your_tos_secret_key
# TOS 服务端点（在桶概览页获取，不含 https://）
# 例如: tos-cn-beijing.volces.com
TOS_ENDPOINT=tos-cn-beijing.volces.com
# 地域（在桶概览页获取）
# 例如: cn-beijing
TOS_REGION=cn-beijing
# 桶名称
TOS_BUCKET=your_bucket_name
# 对象存储前缀（目录），默认 uploads/
TOS_PREFIX=uploads/
# 自定义域名（可选，留空则使用 https://{bucket}.{endpoint}/{key} 形式）
# 若配置则最终访问URL为 https://{TOS_CUSTOM_DOMAIN}/{key}
TOS_CUSTOM_DOMAIN=
